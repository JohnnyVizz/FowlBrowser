{
  "manifest_version": 3,
  "name": "FowlBrowser",
  "short_name": "FowlBrowser",
  "description": "Lets your Claude agents use this browser in the background.",
  "version": "0.1.0",
  "minimum_chrome_version": "125",
  "key": "",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["debugger", "tabs", "tabGroups", "nativeMessaging", "storage", "alarms", "webNavigation", "downloads", "history", "bookmarks", "sessions", "topSites"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "FowlBrowser", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } }
}
